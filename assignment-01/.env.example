# Public. These are HTTPS endpoints of your Neon project and are safe in the browser.
# Row Level Security in Postgres is what protects the data, not secrecy of these URLs.
NEXT_PUBLIC_NEON_AUTH_URL=https://ep-example-123456.neonauth.us-west-2.aws.neon.tech/neondb/auth
NEXT_PUBLIC_NEON_DATA_API_URL=https://ep-example-123456.apirest.us-west-2.aws.neon.tech/neondb/rest/v1

# Server-only. Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=replace-with-a-random-string-of-at-least-32-characters

# Server-only. Used by `npm run db:migrate` and the optional database test. The deployed app never uses it.
DATABASE_URL=postgresql://neondb_owner:password@ep-example-123456.us-west-2.aws.neon.tech/neondb?sslmode=require
