# Copy to .env and fill in only the keys you use. Never commit .env.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Only for a user-scoped key (sk-ant-usr-...): the workspace id (wrkspc_...) from console.anthropic.com > Settings > Workspaces.
ANTHROPIC_WORKSPACE_ID=
TYPESAFE_API_KEY=
# Postgres connection string for the dashboard backend (Neon works). Leave blank to use a local SQLite file.
DATABASE_URL=
